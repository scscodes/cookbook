# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration
# Options: sqlite, postgres
# Default is sqlite if not set.
DB_TYPE=sqlite

# SQLite Settings
# Used when DB_TYPE=sqlite
SQLITE_URL=sqlite:///./app.db

# PostgreSQL Settings
# Used when DB_TYPE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cookbook

# Sync Settings (Optional - future use if parameterized)
SYNC_INTERVAL_INCIDENTS_MINUTES=5
SYNC_INTERVAL_CHANGES_MINUTES=15
SYNC_INTERVAL_EVENTS_MINUTES=30
